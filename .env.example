# ==============================================================================
# Application Configuration
# ==============================================================================
APP_NAME=Python Backend API
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
HOST=127.0.0.1
PORT=8000
APP_RELOAD=true
DOCS=true

# Bytecode (__pycache__) Control
DONT_WRITE_BYTECODE=true

# ==============================================================================
# Security & Cryptography
# ==============================================================================
ENCRYPTION_KEY=your_secret_passphrase_or_32_bytes_key
TOKEN_MANAGER_KEYS={"v1":"your_secret_token_key_minimum_32_characters_long_12345"}

# ==============================================================================
# CORS Configuration
# ==============================================================================
CORS_ORIGINS=*
CORS_HEADERS=*
CORS_METHODS=*
CORS_CREDENTIALS=true
CORS_MAX_AGE=600

# ==============================================================================
# Redis Configuration
# ==============================================================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ==============================================================================
# Database Configurations (Multi-Database Support)
# ==============================================================================
# 1. SQLite File Path & Viewer
audit_logs=db/audit_logs.sqlite
sqlite={"DRIVER":"sqlite","path":"db/audit_logs.sqlite"}

# 2. PostgreSQL
pg={"DRIVER":"pg","DB_HOST":"127.0.0.1","DB_PORT":5432,"DB_NAME":"app_db","DB_USER":"postgres","DB_PASS":"secret","DB_SSLMODE":"prefer"}

# 3. MySQL / MariaDB
mysql={"DRIVER":"mysql","DB_HOST":"127.0.0.1","DB_PORT":3306,"DB_NAME":"app_db","DB_USER":"root","DB_PASS":"secret","DB_CHARSET":"utf8mb4"}
