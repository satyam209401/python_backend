APP_NAME=Python Backend API
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
HOST=127.0.0.1
PORT=8000

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# SQLite Configuration
SQLITE_DIR=database

# CORS Configuration
CORS_ORIGINS=*
CORS_HEADERS=*

# Token Manager Keys (Key-ID to 32+ character secret mapping)
TOKEN_MANAGER_KEYS={"v1":"your_secure_random_32_char_secret_key_here_123456"}

# Database Configuration (MySQL Pool)
user={"DB_HOST":"127.0.0.1","DB_PORT":3306,"DB_NAME":"your_database_name","DB_USER":"root","DB_PASS":"your_secure_password"}

# Database Configuration (PostgreSQL Pool)
# pg_user={"DB_HOST":"127.0.0.1","DB_PORT":5432,"DB_NAME":"your_pg_db","DB_USER":"postgres","DB_PASS":"your_secure_password"}
